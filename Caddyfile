# Both hostnames, one block, on purpose. `cue.krevo.io` is the production origin
# and `staging.cue.krevo.io` is kept resolving as the rollback: flipping
# PUBLIC_URL back is the whole recovery, and it only works if the old hostname
# still answers. Once production is proven, staging becomes a 308 to it and
# CUE_ROBOTS=all goes in .env — in that order, because a shared block would
# otherwise make staging indexable alongside production.
cue.krevo.io, staging.cue.krevo.io {
	encode zstd gzip

	header {
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin

		# The console is not for search engines, and neither is staging as a
		# whole. Hardcoding noindex here would mean editing this file to launch
		# production — exactly the edit that gets forgotten and de-indexes a
		# launch. Production sets CUE_ROBOTS=all in /opt/cue/.env instead.
		X-Robots-Tag "{$CUE_ROBOTS:noindex, nofollow}"

		# Without HSTS only the 308 forces HTTPS, and an on-path attacker strips
		# that on first contact — before any cookie for the operator login is
		# protected. Subdomains included because this is a *.krevo.io host.
		Strict-Transport-Security "max-age=31536000; includeSubDomains"

		# 'unsafe-inline' is required: the App Router emits inline bootstrap
		# scripts and inline style, and there is no nonce plumbing in the app.
		# So script-src is not an XSS defence yet — frame-ancestors, base-uri,
		# object-src and form-action are, and they cost nothing.
		# Upgrade path: nonces via middleware, then drop 'unsafe-inline'.
		Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; object-src 'none'; form-action 'self'"

		Permissions-Policy "accelerometer=(), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=()"
		Cross-Origin-Opener-Policy same-origin

		-Server
		-X-Powered-By
		-Via # Caddy adds this on every proxied response and names itself
	}

	reverse_proxy app:3000 {
		header_up X-Real-IP {remote_host}

		# A deploy recreates the app container; without this every request in
		# that window is a 502. Caddy holds the request and retries the upstream
		# until it answers, so the restart is invisible to users.
		lb_try_duration 30s
		lb_try_interval 250ms
	}

	log {
		output file /data/access.log {
			roll_size 10MiB
			roll_keep 5
		}
	}
}
