# Local development only. Production values live in Vercel project settings.
# Never commit populated environment files.

# Neon pooled connection used by the application.
DATABASE_URL=

# Neon direct connection used only by the migration script.
DATABASE_URL_UNPOOLED=

# Optional explicit migration connection. Falls back to DATABASE_URL_UNPOOLED.
MIGRATE_DATABASE_URL=

# Upstash REST credentials injected by the Vercel Marketplace integration.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Signs Better Auth session cookies. Rotating it logs everyone out.
BETTER_AUTH_SECRET=

# Salts stored IP hashes so the waitlist and signature record keep no raw addresses.
# Changing it makes existing hashes unlinkable to new ones.
IP_SALT=

# Optional local override for Better Auth cookies and redirects. No trailing slash.
PUBLIC_URL=https://cue.krevo.io

# Operator credentials used ONLY by scripts/smoke.sh after each deploy, so the
# authenticated half of the contract (guest list, PATCH validation, and that
# sign-out actually revokes) is verified on every deploy rather than never.
# Without these, smoke runs unauthenticated and reports "incomplete".
SMOKE_EMAIL=
SMOKE_PASSWORD=
