# Copy to .env on the VPS and fill with generated values. Never commit .env.
# Generate secrets ON the server so they never touch a laptop or a chat window:
#
#   POSTGRES_PASSWORD=$(openssl rand -base64 33 | tr -d '/+=' | head -c 40)
#   BETTER_AUTH_SECRET=$(openssl rand -base64 48 | tr -d '/+=' | head -c 56)
#   IP_SALT=$(openssl rand -hex 24)

# Postgres superuser password. Compose builds DATABASE_URL from this.
POSTGRES_PASSWORD=

# Signs Better Auth session cookies. Rotating it logs everyone out.
BETTER_AUTH_SECRET=

# Salts the SHA-256 of signup IPs so the waitlist stores no raw addresses.
# Changing it makes existing hashes unlinkable to new ones.
IP_SALT=

# Public origin, used by Better Auth for cookies and redirects. No trailing slash.
PUBLIC_URL=https://staging.cue.krevo.io
